[Unit]
Description=Gusty Live Overlay - renders real-time state to .pngs for livestream.
PartOf=gusty.target
After=network.target

[Service]
Type=simple
User=flyfunston
Group=flyfunston
WorkingDirectory=/home/flyfunston/gusty
ExecStart=/usr/bin/python3 /home/flyfunston/gusty/live_overlay.py
Restart=on-failure

[Install]
WantedBy=gusty.target
